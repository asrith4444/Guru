       "title": "Add data source",
       "text": "Grafana needs a **data source** before any panel can show data. Choose the type and the URL Grafana's *server* uses to reach it (not your browser)."
      },
      {
       "type": "form",
       "id": "ds",
       "title": "Prometheus settings",
       "fields": [
        {
         "id": "type",
         "label": "Type",
         "kind": "select",
         "options": [
          "Prometheus",
          "Loki",
          "PostgreSQL",
          "Elasticsearch"
         ],
         "value": "Prometheus"
        },
        {
         "id": "url",
         "label": "Prometheus server URL",
         "kind": "text",
         "options": [],
         "value": "http://localhost:9090"
        },
        {
         "id": "scrape",
         "label": "Scrape interval",
         "kind": "text",
         "options": [],
         "value": "15s"
        }
       ],
       "submit_label": "Save & test",
       "rules": [
        {
         "conditions": [
          {
           "field": "type",
           "pattern": "^Prometheus$"
          },
          {
           "field": "url",
           "pattern": "^https?://prometheus:9090/?$"
          }
