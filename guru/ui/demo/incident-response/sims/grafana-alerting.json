         "ok": false,
         "message": "✖ That query is total traffic, not errors. Alert on the 5xx *ratio* (errors ÷ all requests).",
         "effects": {
          "set_flags": [],
          "clear_flags": [],
          "node_status": [],
          "message": ""
         }
        }
       ],
       "fallback": "✖ The rule doesn't match the requirement: 5xx ratio above 5% (0.05) for 5m. Check the query, threshold and pending period."
      }
