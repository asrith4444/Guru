          {
           "field": "for",
           "pattern": "^5m$"
          }
         ],
         "ok": true,
         "message": "✔ Rule saved. State: Pending → Firing (error ratio 6.4% for 5m).",
         "effects": {
          "set_flags": [
           "alert_created"
          ],
          "clear_flags": [],
          "node_status": [
